};

function MiniBars({ values }) {
  const max = Math.max(...values, 1);

  return (
    <div className="flex items-end gap-2 h-24">
      {values.map((v, i) => (
        <div key={i} className="flex-1 rounded-xl bg-slate-200 overflow-hidden">
          <div
            className="w-full rounded-xl bg-slate-700/80"
            style={{ height: `${Math.max((v / max) * 100, 8)}%` }}
          />
        </div>
      ))}
    </div>
  );
}

function StatCard({ icon, label, value, sublabel }) {
  return (
    <Card className="rounded-3xl shadow-sm border-slate-200">
      <CardContent className="p-5 flex items-center gap-4">
        <div className="rounded-2xl bg-slate-100 p-3 text-xl">
          <Icon symbol={icon} />
        </div>
        <div>
          <div className="text-sm text-slate-500">{label}</div>
          <div className="text-2xl font-semibold tracking-tight">{value}</div>
          {sublabel ? (
            <div className="text-xs text-slate-500 mt-1">{sublabel}</div>
          ) : null}
        </div>
      </CardContent>
    </Card>
  );
}

